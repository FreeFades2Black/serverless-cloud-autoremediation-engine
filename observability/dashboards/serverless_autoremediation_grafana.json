{
  "title": "Serverless Autoremediation Engine Golden Signals",
  "schemaVersion": 38,
  "panels": [
    {
      "title": "Mean Time to Remediate (MTTR) - Seconds",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(remediation_duration_seconds_bucket[5m]))",
          "legendFormat": "p95 MTTR (s)"
        }
      ]
    },
    {
      "title": "Active Findings Remediated / hr",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(remediation_actions_total[1h])) by (action_type)",
          "legendFormat": "{{action_type}}"
        }
      ]
    },
    {
      "title": "DLQ Dead-Letter Depth (Target: 0)",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "aws_sqs_approximate_number_of_messages_visible{queue_name=\"remediation-dlq\"}",
          "legendFormat": "Unprocessed DLQ"
        }
      ]
    },
    {
      "title": "Lambda Execution Errors",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(aws_lambda_errors_total[5m]))",
          "legendFormat": "Errors / sec"
        }
      ]
    }
  ]
}